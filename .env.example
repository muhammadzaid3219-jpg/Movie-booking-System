# Copy this file to ".env" and adjust. Never commit the real .env.
# Node loads it automatically at startup (src/config.js).

# ---------- server ----------
NODE_ENV=development
PORT=3000

# ---------- database ----------
# firestore (default) or sqlite
DB_DRIVER=firestore
# Firestore credentials come from firebase-key.json in the project root,
# or from a path in GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# ---------- authentication ----------
# local    = passwords hashed with scrypt in this app's own database
# firebase = accounts live in Firebase Authentication (visible in its console)
AUTH_PROVIDER=local
# Only needed if the Web API key cannot be discovered automatically:
# FIREBASE_WEB_API_KEY=

# ---------- security ----------
# REQUIRED in production - the server refuses to start with the default.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7
SESSION_COOKIE=mbs_token
# Send cookies over HTTPS only. Defaults to on in production.
COOKIE_SECURE=false

# ---------- booking rules ----------
HOLD_MINUTES=8
MAX_SEATS_PER_BOOKING=10
SERVICE_FEE_PERCENT=5
BOOKING_FEE_PER_SEAT=20
CANCEL_CUTOFF_MINUTES=60

# ---------- payments ----------
# mock | stripe | easypaisa | jazzcash   (only "mock" is implemented)
PAYMENT_PROVIDER=mock
CURRENCY=PKR
CURRENCY_SYMBOL=Rs
# Fraction of mock payments that fail, for testing the failure path (0 to 1)
MOCK_FAILURE_RATE=0
# Real gateway keys go here, never in the source:
# STRIPE_SECRET_KEY=
# EASYPAISA_STORE_ID=

# ---------- uploads ----------
UPLOAD_MAX_BYTES=5242880

# ---------- password reset ----------
RESET_TTL_MINUTES=30
# With no mail service wired up, the reset link is returned by the API so the
# flow is testable. Turn this OFF once real email is connected.
RESET_REVEAL_LINK=true
